# Template only: replace placeholders locally; never commit .env.
POSTGRES_PASSWORD=replace_with_a_local_database_password
DATABASE_URL=postgresql+psycopg://regintel:replace_with_a_local_database_password@127.0.0.1:5432/regintel_db
